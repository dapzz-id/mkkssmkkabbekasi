<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. CEGAH DIRECTORY BROWSING
    <IfModule mod_negotiation.c>
        Options -Indexes -MultiViews
    </IfModule>

    # 2. SOLUSI GAMBAR: Teruskan /storage/ langsung ke public/storage/ (Symlink)
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # 3. KEAMANAN: Blokir file tersembunyi (.env, .git, dll)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # 4. KEAMANAN: Blokir folder internal sistem Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$ - [F,L]

    # 5. KEAMANAN: Lindungi folder internal storage (logs, framework, app), tanpa mengganggu public media
    RewriteRule ^storage/(app|framework|logs)(/.*)?$ - [F,L]

    # 6. KEAMANAN: Blokir file konfigurasi sensitif di root
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.env.*|vite\.config\.js|postcss\.config\.js|tailwind\.config\.js)$ - [F,L]

    # 7. ROUTING UTAMA: Lempar semua request web lainnya ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>

