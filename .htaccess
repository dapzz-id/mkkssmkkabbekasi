<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. CEGAH DIRECTORY LISTING (Browsing folder tanpa index)
    <IfModule mod_negotiation.c>
        Options -Indexes -MultiViews
    </IfModule>

    # 2. KEAMANAN: BLOKIR AKSES KE FILE DOT (.env, .git, .htaccess, dll)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # 3. KEAMANAN: BLOKIR AKSES LANGSUNG KE FOLDER SYSTEM LARAVEL
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # 4. KEAMANAN: BLOKIR FILE KONFIGURASI SENSITIF DI ROOT
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.env.*|vite\.config\.js|postcss\.config\.js|tailwind\.config\.js)$ - [F,L]

    # 5. CANONICAL CLEAN URL: Hilangkan kata '/public/' jika diketik manual di browser
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # 6. FORWARD UTAMA: Alihkan semua request publik ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
